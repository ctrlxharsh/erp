# Copy to .env.local (never commit real values). `neon deploy` / `neon env pull` fill the Neon values.
# Run `neon checkout test` first so you point at the test branch, never production.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Later phases: S3_* storage settings (0.5), RESEND_API_KEY and EMAIL_FROM (0.6)
